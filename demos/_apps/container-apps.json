        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-{1}', parameters('namePrefix'), variables('suffix')))]"
      ]
    }
  ],
  "outputs": {
    "frontendUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-web-{1}', parameters('namePrefix'), variables('suffix'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "frontendAppName": {
      "type": "string",
      "value": "[format('{0}-web-{1}', parameters('namePrefix'), variables('suffix'))]"
    },
    "backendAppName": {
      "type": "string",
      "value": "[format('{0}-api-{1}', parameters('namePrefix'), variables('suffix'))]"
    },
    "appInsightsName": {
      "type": "string",
      "value": "[format('appi-{0}-{1}', parameters('namePrefix'), variables('suffix'))]"
    }
  }
