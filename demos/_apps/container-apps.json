      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "IPv4 CIDR ranges allowed to reach the frontend. Empty means public."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "ipRestrictions",
        "count": "[length(parameters('allowedIpRanges'))]",
        "input": {
          "name": "[format('allow-{0}', copyIndex('ipRestrictions'))]",
          "ipAddressRange": "[parameters('allowedIpRanges')[copyIndex('ipRestrictions')]]",
